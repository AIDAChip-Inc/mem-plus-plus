# memory-research engine — local configuration (copy to .env and edit).
#
# MEMORY_DATABASE_URL — a plain local DSN. No Railway/remote/1Password/self-heal.
#
# DEFAULT (Docker-free): run_demo.sh creates a project-local Postgres cluster in
# ./.pgdata reachable over a unix socket in ./.pgsock, and computes+exports this
# DSN automatically at launch — you do NOT need to set it here. The socket dir is
# an absolute path that varies per machine, hence it is derived at runtime:
#   postgresql+psycopg2://<os-user>@/memory_research?host=<abs-path>/.pgsock
#
# Manual fallback (only if you run the engine WITHOUT run_demo.sh) — point it at
# your own cluster's socket, e.g.:
#   MEMORY_DATABASE_URL=postgresql+psycopg2://youruser@/memory_research?host=/abs/path/memory-research/.pgsock
#
# Docker alternative (docker-compose.yml): a Postgres 16 + pgvector container on
# host port 5433. If you use that path instead, set:
#   MEMORY_DATABASE_URL=postgresql+psycopg2://memory:memory@localhost:5433/memory_research

# Scope identity (see memory/recall.py). project_id/customer_id are derived
# deterministically from a fixed namespace; only the human login is overridable.
# MEMORY_USER overrides the OS login used to derive user_id + the by:<slug> tag.
# MEMORY_USER=alice

# Extraction LLM (store_facts). Optional — absent/unset degrades cleanly to a
# no-op (store_facts writes nothing; store_facts_verbatim is unaffected). The
# SDK also resolves an `ant auth login` profile when this is unset.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional single-owner Gradio login; remains loopback-only.
MEMORY_UI_AUTH_ENABLED=0
MEMORY_UI_USERNAME=
MEMORY_UI_PASSWORD=
